# ============================================================
# .gitignore — check this before every single commit
# ============================================================

# Environment and secrets — NEVER commit these
.env
.env.*
!.env.example
*.pem
*.key
*.p12
secrets/
credentials/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
eggs/
.eggs/
*.egg-info/
*.egg
MANIFEST
pip-wheel-metadata/

# Virtual environments
.venv/
venv/
env/
ENV/

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/
*.log

# IDE
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Deployment artifacts
*.tar.gz
node_modules/

# Local uploads / personal files
static/resume.pdf

# Demo output (generated SVG diagrams)
examples/output/*.svg
examples/output/*.png

# ============================================================
# ElevateBox Voice Agent — Environment Variables
# ============================================================
#
# SETUP:
#   cp .env.example .env
#   # Fill in your values below, then:
#   uvicorn src.main:app --reload --port 8000
#
# NEVER commit your real .env file. It is already in .gitignore.
# Run `python examples/demo_classifier.py` to try the system
# with NO API keys at all — the core intelligence modules work offline.
# ============================================================


# ─── Vapi.ai ─────────────────────────────────────────────────
# Sign up: https://app.vapi.ai  ($10 free credit ≈ 200 min of calls)
# Docs:    https://docs.vapi.ai
#
# API key: Dashboard → Settings → API Keys → copy secret key
VAPI_API_KEY=vapi_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Phone Number ID — NOT the phone number itself (looks like a UUID).
# Vapi → Phone Numbers → Import from Twilio → copy the resulting ID.
VAPI_PHONE_NUMBER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx


# ─── OpenAI ──────────────────────────────────────────────────
# Sign up: https://platform.openai.com
# GPT-4o is required for reliable multilingual intent classification.
# gpt-4o-mini cuts cost ~75% but may misclassify indirect/code-switched answers.
#
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o


# ─── Twilio ──────────────────────────────────────────────────
# Sign up: https://twilio.com  ($15 free trial credit)
# Console: https://console.twilio.com
#
# Account SID: starts with AC (shown on Console homepage)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Auth Token: shown next to Account SID on Console homepage
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# WhatsApp sender number.
# Testing  → use the sandbox number below (free, no approval)
# Production → replace with your approved WhatsApp Business number
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# WhatsApp Sandbox opt-in (one-time per test number):
#   1. Console → Messaging → Try WhatsApp → note your sandbox keyword
#   2. Send "join <keyword>" from the TARGET phone to +14155238886 on WhatsApp
#   3. That number can now receive messages from your sandbox
TWILIO_WHATSAPP_SANDBOX_KEYWORD=join your-sandbox-keyword


# ─── Call Target ─────────────────────────────────────────────
# Phone number to call. Must be in E.164 format: +[country code][number]
# This number also receives all WhatsApp follow-up messages.
TARGET_PHONE=+919999999999


# ─── Server / Webhooks ───────────────────────────────────────
# Public URL where this server is reachable. Vapi delivers all call
# events (speech, function calls, end-of-call) to BASE_URL/webhook/vapi.
#
# Local dev with ngrok:
#   Run: ngrok http 8000
#   Copy the https://xxxx.ngrok.io URL here
#
# Render.com deploy:
#   Use the URL Render assigns, e.g. https://elevate-voice-agent.onrender.com
#
BASE_URL=https://xxxx.ngrok.io

# Environment tag — set to "production" to hide /docs endpoint
ENVIRONMENT=development

# Port (Render sets $PORT automatically; local default is 8000)
PORT=8000


# ─── Security ────────────────────────────────────────────────
# Protects POST /call, GET /callbacks, GET /analytics endpoints.
# Send as header: X-Admin-Key: <value>
#
# Generate a strong key:
#   python -c "import secrets; print(secrets.token_hex(32))"
#
ADMIN_API_KEY=replace-with-a-long-random-string


# ─── Candidate Details ───────────────────────────────────────
# These appear in WhatsApp messages sent to the lead.
# Replace with your own information.
CANDIDATE_NAME=Your Name Here
CANDIDATE_MOBILE=+919999999999

# Publicly accessible URL to your resume PDF.
# Must be directly downloadable — no login wall.
# Free hosting: Google Drive → Share → Anyone with link → copy direct URL
#               GitHub → upload to repo → use raw.githubusercontent.com URL
CANDIDATE_RESUME_URL=https://your-public-resume-url.com/resume.pdf

# Optional: static architecture diagram URL.
# If blank, the system generates a per-call SVG at /diagram/{call_id}.svg
ARCHITECTURE_IMAGE_URL=


# ─── Logging ─────────────────────────────────────────────────
# DEBUG shows every webhook payload and classification decision.
# INFO is recommended for normal operation.
LOG_LEVEL=INFO
